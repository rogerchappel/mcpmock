{
  "name": "minimal-catalog",
  "description": "Minimal catalog with a single tool",
  "tools": [
    {
      "name": "echo",
      "description": "Echo back the input message",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message to echo"
          }
        },
        "required": ["message"]
      },
      "responses": {
        "default": {
          "content": [
            {
              "type": "text",
              "text": "Echo: {message}"
            }
          ]
        }
      }
    }
  ]
}
