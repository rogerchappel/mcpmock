{
  "name": "transcript-sample",
  "description": "Sample orchestration transcript",
  "vars": {
    "query": "typescript"
  },
  "steps": [
    {
      "tool": "search",
      "args": {
        "query": "${query}",
        "limit": 5
      },
      "storeAs": "results"
    },
    {
      "tool": "read_file",
      "args": {
        "path": "./src/results.txt"
      },
      "storeAs": "content"
    },
    {
      "tool": "create_file",
      "args": {
        "path": "./output/summary.txt",
        "content": "Search results for typescript"
      }
    }
  ]
}
