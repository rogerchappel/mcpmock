{
  "name": "mcpmock",
  "version": "0.1.0",
  "description": "Fixture-backed mock MCP tool catalogs for deterministic agent testing",
  "main": "dist/index.js",
  "bin": {
    "mcpmock": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "smoke": "bash scripts/smoke.sh",
    "validate": "bash scripts/validate.sh",
    "release:check": "pnpm run check && pnpm test && bash scripts/smoke.sh"
  },
  "keywords": [
    "mcp",
    "mock",
    "testing",
    "agent",
    "cli",
    "fixture",
    "deterministic"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rogerchappel/mcpmock.git"
  },
  "homepage": "https://github.com/rogerchappel/mcpmock#readme",
  "bugs": {
    "url": "https://github.com/rogerchappel/mcpmock/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  }
}
